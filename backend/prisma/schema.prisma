generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DurasiLayanan {
  REGULER
  EXPRESS
}

enum StatusPembayaran {
  PAID
  UNPAID
  PENDING
}

enum StatusPesanan {
  MENUNGGU
  SEDANG_DIPROSES
  SELESAI
  DIKIRIM
}

enum StatusKurir {
  AKTIF
  TIDAK_AKTIF
}

enum KategoriLayanan {
  CUCI_KILOAN
  DRY_CLEAN
  CUCI_SEPATU
}

enum SatuanLayanan {
  KG
  PCS
  PASANG
}

enum MetodeAntar {
  DIANTAR_KURIR
  DIBAWA_SENDIRI
}

enum MetodeAmbil {
  DIAMBIL_KURIR
  DIJEMPUT_SENDIRI
}

enum Role {
  CUSTOMER
  ADMIN
  KURIR
}

model User {
  id_user String @id @default(uuid())

  nama          String
  email         String @unique
  password_hash String

  no_telepon String?

  role Role

  is_active Boolean @default(true)

  last_login DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer?
  admin    Admin?
  kurir    Kurir?

  @@map("user")
}

model Customer {
  id_customer String @id @default(uuid())
  id_user     String @unique

  tanggal_lahir  DateTime?
  tanggal_daftar DateTime  @default(now())
  alamat         String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [id_user], references: [id_user])

  pemesanan Pemesanan[]
  ulasan    Ulasan[]

  @@index([id_user])
  @@map("customer")
}

model Outlet {
  id_outlet String @id @default(uuid())

  nama_outlet          String
  alamat_outlet        String
  nomor_telepon_outlet String
  jam_buka             String
  jam_tutup            String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  admin     Admin[]
  kurir     Kurir[]
  pemesanan Pemesanan[]

  @@map("outlet")
}

model Admin {
  id_admin String @id @default(uuid())

  id_user   String @unique
  id_outlet String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User   @relation(fields: [id_user], references: [id_user])
  outlet Outlet @relation(fields: [id_outlet], references: [id_outlet])

  @@index([id_outlet])
  @@map("admin")
}

model Kurir {
  id_kurir String @id @default(uuid())

  id_user   String @unique
  id_outlet String

  jenis_kendaraan String
  nomor_kendaraan String

  status_kurir StatusKurir

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User   @relation(fields: [id_user], references: [id_user])
  outlet Outlet @relation(fields: [id_outlet], references: [id_outlet])

  pemesanan Pemesanan[]

  @@index([id_outlet])
  @@map("kurir")
}

model Layanan {
  id_layanan String @id @default(uuid())

  nama_layanan     String
  kategori_layanan KategoriLayanan
  satuan           SatuanLayanan
  harga            Decimal         @db.Decimal(12, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pemesanan Pemesanan[]

  @@map("layanan")
}

model Pemesanan {
  id_pemesanan String @id @default(uuid())

  id_customer String
  id_outlet   String
  id_layanan  String
  id_kurir    String?

  tanggal_pesan DateTime

  jumlah      Int?
  estimasi_kg Decimal? @db.Decimal(8, 2)

  estimasi_harga_laundry Decimal? @db.Decimal(12, 2)
  harga_pengantaran      Decimal? @db.Decimal(12, 2)
  estimasi_total_harga   Decimal? @db.Decimal(12, 2)

  catatan        String?
  durasi_layanan DurasiLayanan

  metode_antar MetodeAntar
  waktu_antar  DateTime?

  metode_ambil MetodeAmbil
  waktu_ambil  DateTime?

  foto_penjemputan_url     String?
  foto_penjemputan_file_id String?
  waktu_foto_penjemputan   DateTime?

  foto_pengantaran_url     String?
  foto_pengantaran_file_id String?
  waktu_foto_pengantaran   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [id_customer], references: [id_customer])
  outlet   Outlet   @relation(fields: [id_outlet], references: [id_outlet])
  layanan  Layanan  @relation(fields: [id_layanan], references: [id_layanan])
  kurir    Kurir?   @relation(fields: [id_kurir], references: [id_kurir])

  transaksi       Transaksi?
  ulasan          Ulasan?
  riwayat_pesanan RiwayatPesanan[]

  @@index([id_customer])
  @@index([id_outlet])
  @@index([id_layanan])
  @@index([id_kurir])
  @@map("pemesanan")
}

model Transaksi {
  id_transaksi String @id @default(uuid())

  id_pemesanan String @unique

  tanggal_pembayaran DateTime

  harga_laundry Decimal @db.Decimal(12, 2)
  total_kg      Decimal @db.Decimal(8, 2)
  total_harga   Decimal @db.Decimal(12, 2)

  status_pembayaran StatusPembayaran

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pemesanan Pemesanan @relation(fields: [id_pemesanan], references: [id_pemesanan])

  riwayat_pesanan RiwayatPesanan[]

  @@map("transaksi")
}

model RiwayatPesanan {
  id_history String @id @default(uuid())

  id_pemesanan String
  id_transaksi String?

  status_pesanan StatusPesanan
  waktu_update   DateTime

  created_at DateTime @default(now())

  pemesanan Pemesanan  @relation(fields: [id_pemesanan], references: [id_pemesanan])
  transaksi Transaksi? @relation(fields: [id_transaksi], references: [id_transaksi])

  @@index([id_pemesanan])
  @@index([id_transaksi])
  @@map("riwayat_pesanan")
}

model Ulasan {
  id_ulasan String @id @default(uuid())

  id_customer  String
  id_pemesanan String @unique

  rating Int
  komen  String

  tanggal_ulasan DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer  Customer  @relation(fields: [id_customer], references: [id_customer])
  pemesanan Pemesanan @relation(fields: [id_pemesanan], references: [id_pemesanan])

  @@index([id_customer])
  @@map("ulasan")
}
